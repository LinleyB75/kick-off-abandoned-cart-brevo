{
  "name": "kick-off-abandoned-cart-brevo",
  "version": "0.1.0",
  "private": true,
  "description": "Abandoned cart email for Kick Off Your English (Geo English), a test version built close to the real one: design, build, checks and tests, documented stage by stage.",
  "scripts": {
    "setup:hooks": "node scripts/install-hooks.js",
    "checks": "node email-checks/run.js templates/email.mjml --params data/params.json",
    "palette": "node email-checks/palette.js",
    "prebuild": "node scripts/make-dist.js",
    "build": "mjml templates/email.mjml --config.validationLevel=strict -o dist/email.html",
    "compare-light": "node email-checks/compare-light.js",
    "check-params": "node check-params.js",
    "test": "node scripts/test-checks.js",
    "send:dry": "node send.js",
    "send:sandbox": "node send.js --sandbox",
    "send:live": "node send.js --live",
    "test:send": "node scripts/test-send.js",
    "simulated-brevo": "node scripts/simulated-brevo.js",
    "simulate": "node scripts/brevo-walkthrough.js --simulated",
    "test:brevo": "node scripts/brevo-walkthrough.js",
    "postbuild": "node scripts/check-build.js",
    "verify": "node scripts/verify-setup.js",
    "data-design": "node scripts/data-design.js",
    "checks:syntax": "node email-checks/run.js templates/email.mjml --no-browser",
    "checks:html": "node email-checks/run.js plain-html/email.html --params data/params.json",
    "compare-html": "node email-checks/compare-light.js templates/email.mjml plain-html/email.html --params data/params.json",
    "record": "node scripts/record-stage.js"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "mjml": "^5.4.1",
    "nunjucks": "^3.2.4",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  }
}
